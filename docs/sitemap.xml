---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
{%- assign lang_codes = "" -%}
{%- for l in site.data.languages -%}{%- assign lang_codes = lang_codes | append: l[0] | append: "," -%}{%- endfor -%}
{%- assign lang_codes = lang_codes | split: "," %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- assign pages = site.html_pages | sort: "url" -%}
{%- for p in pages -%}
{%- if p.noindex or p.sitemap == false -%}{%- continue -%}{%- endif -%}
{%- assign url_parts = p.url | split: "/" -%}
{%- assign url_lang = url_parts[1] | default: "" -%}
{%- unless lang_codes contains url_lang -%}{%- continue -%}{%- endunless -%}
{%- assign page_path = p.url | remove_first: "/" | remove_first: url_lang %}
	<url>
		<loc>{{ p.url | relative_url | absolute_url }}</loc>
		{%- for l in site.data.languages %}
		<xhtml:link rel="alternate" hreflang="{{ l[0] }}" href="{{ '/' | append: l[0] | append: page_path | relative_url | absolute_url }}"/>
		{%- endfor %}
		<xhtml:link rel="alternate" hreflang="x-default" href="{{ '/en' | append: page_path | relative_url | absolute_url }}"/>
	</url>
{%- endfor %}
</urlset>
